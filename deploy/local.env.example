# 复制为 deploy/local.env。仅保存本机启动选项，不提交 Git。
# IP、网卡与目录只在这里设置一次；已有 TOML 和密钥不会被修改。
# 命令行环境变量优先。相对目录从仓库根目录解析。

# Go2 本体必填；直连网络、不使用隧道时留空 AGENT_HOST。
# export NETWORK_INTERFACE="${NETWORK_INTERFACE:-eth0}"
# export AGENT_HOST="${AGENT_HOST:-user@agent-host}"
# export AGENT_SSH_PORT="${AGENT_SSH_PORT:-22}"

# Conda 不在 PATH 中时填写；也可先 conda activate nav-agent。
# export CONDA_EXE="${CONDA_EXE:-/path/to/miniconda3/bin/conda}"

# 新建模型镜像：x86_64 默认 upstream，检测到 Thor 时使用 thor。
# 非 Thor 的 ARM 设备必须指定已验证镜像，不使用 thor 构建。
# Thor 编译默认 2 路；仅在内存充足时提高，不影响模型推理参数。
# export VLLM_BUILD_JOBS="${VLLM_BUILD_JOBS:-2}"
# export LIGHTNAV_PLATFORM="${LIGHTNAV_PLATFORM:-thor}"
# export LIGHTNAV_IMAGE="${LIGHTNAV_IMAGE:-navigation-lightnav:local}"
# export LIGHTNAV_SOURCE="${LIGHTNAV_SOURCE:-.runtime/lightnav/upstream}"
# export LIGHTNAV_WEIGHTS="${LIGHTNAV_WEIGHTS:-.runtime/lightnav/upstream/checkpoints/LightNav-0}"
# export DETECTOR_MODELS="${DETECTOR_MODELS:-runs/target-detector/models}"
# export DETECTOR_IMAGE="${DETECTOR_IMAGE:-navigation-target-detector:local}"

# 使用其他已部署的模型服务时，禁止本机自动启动模型容器。
# export START_MODELS="${START_MODELS:-0}"
# 默认要求容器归属和服务标签均匹配；仅在确认归属与用途后允许复用旧容器。
# export REUSE_EXISTING="${REUSE_EXISTING:-1}"

# 更换配置文件只选择文件，不写入、不覆盖文件内容。
# export MUJOCO_CONFIG="${MUJOCO_CONFIG:-configs/mujoco-lightnav.toml}"
# export GO2_CONFIG="${GO2_CONFIG:-configs/go2-lightnav.toml}"
